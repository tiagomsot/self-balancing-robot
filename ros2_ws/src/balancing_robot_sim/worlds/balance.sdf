<?xml version="1.0"?>
<sdf version="1.9">
  <world name="balance">
    <gravity>0 0 -9.81</gravity>
    <physics name="fixed_step" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.85 0.9 0.95 1</background>
    </scene>
    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>Balancing robot</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.5 0.5 0.5</ambient_light>
        <background_color>0.85 0.9 0.95</background_color>
        <camera_pose>0.9 -1.1 0.65 0 0.32 2.25</camera_pose>
        <camera_clip><near>0.01</near><far>100</far></camera_clip>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
      <plugin filename="InteractiveViewControl" name="View Control"/>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">floating</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">160</property>
          <property type="double" key="x">10</property>
          <property type="double" key="y">10</property>
        </gz-gui>
        <play_pause>true</play_pause><step>true</step>
        <start_paused>true</start_paused>
        <service>/world/balance/control</service>
      </plugin>
    </gui>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -1</direction><cast_shadows>true</cast_shadows>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.65 0.68 0.7 1</ambient><diffuse>0.65 0.68 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>

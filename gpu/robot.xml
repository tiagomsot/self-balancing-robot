<mujoco model="balancing_robot_gpu">
  <compiler angle="radian"/>
  <option timestep="0.001" gravity="0 0 -9.81" integrator="Euler"
          solver="Newton" iterations="20" tolerance="1e-8"/>
  <default>
    <joint damping="0" frictionloss="0" armature="0"/>
    <geom friction="0.8 0.001 0.0001" condim="3" solref="0.01 1"/>
  </default>
  <worldbody>
    <light pos="0 -1 3"/>
    <geom name="floor" type="plane" size="5 5 0.1" rgba="0.8 0.8 0.8 1"/>
    <body name="base" pos="0 0 0.041">
      <freejoint name="root"/>
      <geom name="body" type="box" pos="0 0 0.048" size="0.0175 0.05 0.075"
            mass="0.42" rgba="0.15 0.5 0.85 1"/>
      <site name="imu" pos="0 0 0.06" size="0.001" rgba="0.15 0.8 0.3 1"/>
      <body name="left_wheel" pos="0 0.084 0">
        <joint name="left" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.04 0.004" quat="0.7071067812 0.7071067812 0 0"
              mass="0.02" rgba="0.12 0.12 0.12 1"/>
      </body>
      <body name="right_wheel" pos="0 -0.084 0">
        <joint name="right" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.04 0.004" quat="0.7071067812 0.7071067812 0 0"
              mass="0.02" rgba="0.12 0.12 0.12 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="left_torque" joint="left" gear="1"/>
    <motor name="right_torque" joint="right" gear="1"/>
  </actuator>
  <sensor>
    <accelerometer name="imu_accel" site="imu"/>
    <gyro name="imu_gyro" site="imu"/>
  </sensor>
</mujoco>
